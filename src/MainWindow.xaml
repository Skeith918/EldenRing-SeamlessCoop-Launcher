<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elden Ring · Seamless Co-op" Width="1100" Height="620"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0B0A09" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="#EDE6D6">
  <Window.Resources>
    <FontFamily x:Key="Serif">Palatino Linotype</FontFamily>
    <SolidColorBrush x:Key="Gold" Color="#D4B26A"/>
    <SolidColorBrush x:Key="GoldDim" Color="#8F7745"/>
    <SolidColorBrush x:Key="Text" Color="#EDE6D6"/>
    <SolidColorBrush x:Key="Muted" Color="#A39C8C"/>
    <SolidColorBrush x:Key="Ok" Color="#8BC48A"/>
    <SolidColorBrush x:Key="Bad" Color="#DE7A66"/>
    <SolidColorBrush x:Key="Off" Color="#6B655A"/>
    <LinearGradientBrush x:Key="GoldGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F4E2A8" Offset="0"/>
      <GradientStop Color="#D2AE5E" Offset="0.5"/>
      <GradientStop Color="#9E7B37" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="ToolTip">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="#F2141312" BorderBrush="#808F7745" BorderThickness="1" CornerRadius="4" Padding="10,7" MaxWidth="380">
              <ContentPresenter TextElement.Foreground="#EDE6D6" TextElement.FontSize="12"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1C1509"/>
      <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="3" Background="{StaticResource GoldGrad}">
                <Border.Effect>
                  <DropShadowEffect Color="#E8C26A" BlurRadius="26" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Hi" CornerRadius="3" BorderBrush="#FFF6DD9A" BorderThickness="1" Background="Transparent"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hi" Property="Background" Value="#30FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hi" Property="Background" Value="#26000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#59000000">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#33D4B26A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#55D4B26A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" BorderBrush="#4DD4B26A" BorderThickness="1" Background="#40000000">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2BD4B26A"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#4DD4B26A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Arrow" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="13" BorderBrush="#4DD4B26A" BorderThickness="1" Background="#40000000">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#33D4B26A"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Background="Transparent" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#CFC8B8"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="GroupName" Value="Tabs"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
              <Rectangle x:Name="U" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource GoldGrad}" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                <Setter TargetName="U" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10" VerticalAlignment="Center"
                      Background="#33FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1">
                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0" Fill="#E8E2D4" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource GoldGrad}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="#F4E2A8"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Fill" Value="#1C1509"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrackPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="20">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Background="{StaticResource Gold}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Background="#33FFFFFF"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="{StaticResource GoldGrad}" Stroke="#1C1509" StrokeThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="#66000000" BorderBrush="#59D4B26A" BorderThickness="1" CornerRadius="3" Padding="10,7">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#99D4B26A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#33FFFFFF" CornerRadius="1.5"/>
              <Border x:Name="PART_Indicator" Background="{StaticResource GoldGrad}" CornerRadius="1.5" HorizontalAlignment="Left"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Pulse">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.7"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="Pulse"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="4" Background="Transparent" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#26D4B26A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <Image x:Name="Bg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <!-- lisibilité : assombrit la colonne gauche, le haut et le bas, laisse le groupe de joueurs visible au centre -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#EB080706" Offset="0"/>
          <GradientStop Color="#B3080706" Offset="0.25"/>
          <GradientStop Color="#00080706" Offset="0.42"/>
          <GradientStop Color="#00080706" Offset="0.62"/>
          <GradientStop Color="#73080706" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#99080706" Offset="0"/>
          <GradientStop Color="#00080706" Offset="0.18"/>
          <GradientStop Color="#00080706" Offset="0.6"/>
          <GradientStop Color="#D9080706" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- titre -->
    <StackPanel Margin="50,62,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <TextBlock x:Name="Title" Text="ELDEN RING" FontFamily="{DynamicResource Serif}" FontSize="62" Foreground="{StaticResource GoldGrad}">
        <TextBlock.Effect>
          <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
        </TextBlock.Effect>
      </TextBlock>
      <TextBlock x:Name="Subtitle" Text="SEAMLESS CO-OP" FontFamily="{DynamicResource Serif}" FontSize="19" Foreground="{StaticResource Text}" Margin="3,0,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="4,14,0,14">
        <Rectangle Width="7" Height="7" Fill="{StaticResource Gold}" VerticalAlignment="Center">
          <Rectangle.LayoutTransform>
            <RotateTransform Angle="45"/>
          </Rectangle.LayoutTransform>
        </Rectangle>
        <Rectangle Width="260" Height="1" VerticalAlignment="Center" Margin="6,0,0,0">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FFD4B26A" Offset="0"/>
              <GradientStop Color="#00D4B26A" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </StackPanel>
      <TextBlock x:Name="Tagline" FontSize="14" Foreground="{StaticResource Text}" Opacity="0.85" Margin="3,0,0,0"/>
    </StackPanel>

    <!-- état + actions -->
    <StackPanel Width="340" Margin="50,0,0,30" HorizontalAlignment="Left" VerticalAlignment="Bottom">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="58"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="25"/>
          <RowDefinition Height="25"/>
          <RowDefinition Height="25"/>
          <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Ellipse x:Name="GameDot" Grid.Row="0" Width="7" Height="7" Fill="{StaticResource Off}" HorizontalAlignment="Left"/>
        <Ellipse x:Name="ModDot" Grid.Row="1" Width="7" Height="7" Fill="{StaticResource Off}" HorizontalAlignment="Left"/>
        <Ellipse x:Name="EacDot" Grid.Row="2" Width="7" Height="7" Fill="{StaticResource Off}" HorizontalAlignment="Left"/>
        <Ellipse x:Name="SteamDot" Grid.Row="3" Width="7" Height="7" Fill="{StaticResource Off}" HorizontalAlignment="Left"/>
        <TextBlock x:Name="LblGame" Grid.Row="0" Grid.Column="1" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldDim}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="MOD" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldDim}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="EAC" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldDim}" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="STEAM" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldDim}" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" LastChildFill="True">
          <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Changer" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="GameText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ModText" Grid.Row="1" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="EacText" Grid.Row="2" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="SteamText" Grid.Row="3" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
      <ProgressBar x:Name="Progress" Style="{StaticResource GoldProgress}" Maximum="100" Visibility="Hidden" Margin="0,0,0,16"/>

      <Button x:Name="UpdateBtn" Style="{StaticResource Ghost}" Height="40" Margin="0,0,0,12" Visibility="Collapsed"/>
      <Button x:Name="MainBtn" Style="{StaticResource GoldButton}" Height="58" Content="JOUER"/>
    </StackPanel>

    <!-- panneau de réglages (verre dépoli) -->
    <Border x:Name="Panel" Width="356" Margin="0,54,28,28" HorizontalAlignment="Right" CornerRadius="10" BorderThickness="1" BorderBrush="#47D4B26A">
      <Grid x:Name="PanelInner">
        <Canvas ClipToBounds="True">
          <Image x:Name="PanelBg" Stretch="UniformToFill">
            <Image.Effect>
              <BlurEffect Radius="26" RenderingBias="Performance"/>
            </Image.Effect>
          </Image>
        </Canvas>
        <Border Background="#B80E0D0B"/>
        <DockPanel Margin="24,10,24,18">
          <Grid DockPanel.Dock="Top" Height="40" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#33D4B26A"/>
            <RadioButton x:Name="TabSession" Grid.Column="0" Style="{StaticResource Tab}" Content="SESSION" IsChecked="True"/>
            <RadioButton x:Name="TabDiff" Grid.Column="1" Style="{StaticResource Tab}" Content="DIFFICULTÉ"/>
            <RadioButton x:Name="TabAdv" Grid.Column="2" Style="{StaticResource Tab}" Content="AVANCÉ"/>
          </Grid>
          <Grid>
            <StackPanel x:Name="PageSession"/>
            <StackPanel x:Name="PageDiff" Visibility="Collapsed"/>
            <StackPanel x:Name="PageAdv" Visibility="Collapsed"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>

    <!-- barre de titre -->
    <Grid VerticalAlignment="Top" Height="34">
      <TextBlock x:Name="Caption" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Muted}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LangBtn" Style="{StaticResource TitleBtn}" Width="Auto" Tag="#22FFFFFF">
          <StackPanel Orientation="Horizontal" Margin="12,0">
            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="LangCode" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,1" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" Tag="#22FFFFFF"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" Tag="#C42B1C"/>
      </StackPanel>
      <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangBtn}" Placement="Bottom" VerticalOffset="2"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Width="170" Background="#F5141210" BorderBrush="#808F7745" BorderThickness="1" CornerRadius="6" Padding="5">
          <StackPanel x:Name="LangList"/>
        </Border>
      </Popup>
    </Grid>

    <!-- boîte de dialogue intégrée -->
    <Grid x:Name="Overlay" Background="#B3000000" Margin="0,34,0,0" Visibility="Collapsed">
      <Border Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F5141210"
              BorderBrush="#808F7745" BorderThickness="1" CornerRadius="8" Padding="28,22,28,24">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="19" Foreground="{StaticResource Gold}" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Margin="0,12,0,22" TextWrapping="Wrap" LineHeight="20" FontSize="13.5"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DlgCancel" Style="{StaticResource Ghost}" FontSize="13" Height="36" Padding="20,0" Margin="0,0,10,0"/>
            <Button x:Name="DlgOk" Style="{StaticResource GoldButton}" FontSize="14" Height="36" Padding="24,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
