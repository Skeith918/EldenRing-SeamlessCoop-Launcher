{
  "schema": 1,
  "updated": "2026-10-27",
  "mods": [
    {
      "id": "seamless-coop",
      "name": "Seamless Co-op",
      "author": "Yui",
      "category": "multiplayer",
      "core": true,
      "gameplay": true,
      "nexus": 510,
      "description": {
        "fr": "Coopération sans coupure : explorez tout le jeu à plusieurs, boss compris, avec des invasions et des règles de difficulté réglables.",
        "en": "Seamless co-op: explore the whole game together, bosses included, with configurable invasions and difficulty scaling.",
        "es": "Cooperativo sin cortes: explora todo el juego en compañía, jefes incluidos, con invasiones y dificultad configurables."
      },
      "source": { "type": "github", "repo": "yuiamoroll/EldenRingSeamlessCoopRelease", "asset": "\\.zip$" },
      "games": ["2.7.*"],
      "natives": ["SeamlessCoop/ersc.dll"],
      "special": "seamless",
      "settings": {
        "file": "SeamlessCoop/ersc_settings.ini",
        "format": "ini",
        "tabs": [
          {
            "title": { "fr": "SESSION", "en": "SESSION", "es": "SESIÓN" },
            "items": [
              { "key": "cooppassword", "section": "PASSWORD", "type": "text", "maxLength": 64, "default": "",
                "label": { "fr": "Mot de passe de session", "en": "Session password", "es": "Contraseña de sesión" },
                "hint": { "fr": "Le même pour tous les joueurs du groupe", "en": "Must be the same for every player in the group", "es": "La misma para todos los jugadores del grupo" },
                "placeholder": { "fr": "Choisis un mot de passe…", "en": "Pick a password…", "es": "Elige una contraseña…" } },
              { "key": "allow_invaders", "section": "GAMEPLAY", "type": "toggle", "default": "1",
                "label": { "fr": "Envahisseurs", "en": "Invaders", "es": "Invasores" },
                "hint": { "fr": "D'autres joueurs peuvent envahir votre monde", "en": "Other players can invade your world", "es": "Otros jugadores pueden invadir tu mundo" } },
              { "key": "death_debuffs", "section": "GAMEPLAY", "type": "toggle", "default": "1",
                "label": { "fr": "Malus à la mort", "en": "Death debuffs", "es": "Penalización al morir" },
                "hint": { "fr": "Essence de putréfaction, soignée au site de grâce", "en": "Rot Essence, cured at a Site of Grace", "es": "Esencia de podredumbre, se cura en un lugar de gracia" } },
              { "key": "allow_summons", "section": "GAMEPLAY", "type": "toggle", "default": "1",
                "label": { "fr": "Invocations d'esprits", "en": "Spirit summons", "es": "Invocación de espíritus" },
                "hint": { "fr": "Cendres d'esprit utilisables en coop", "en": "Spirit Ashes usable in co-op", "es": "Cenizas espirituales disponibles en cooperativo" } },
              { "key": "always_spectate_on_death", "section": "GAMEPLAY", "type": "toggle", "default": "0",
                "label": { "fr": "Toujours observer à la mort", "en": "Always spectate on death", "es": "Observar siempre al morir" },
                "hint": { "fr": "Spectateur jusqu'au wipe ou au repos", "en": "Spectate until party wipe or a rest", "es": "Espectador hasta la derrota del grupo o un descanso" } },
              { "key": "overhead_player_display", "section": "GAMEPLAY", "type": "choice", "default": "0",
                "label": { "fr": "Infos des joueurs", "en": "Player info", "es": "Info de jugadores" },
                "choices": [
                  { "fr": "Normal", "en": "Normal", "es": "Normal" },
                  { "fr": "Rien", "en": "None", "es": "Nada" },
                  { "fr": "Ping", "en": "Ping", "es": "Ping" },
                  { "fr": "Niveau", "en": "Level", "es": "Nivel" },
                  { "fr": "Morts", "en": "Deaths", "es": "Muertes" },
                  { "fr": "Niveau + ping", "en": "Level + ping", "es": "Nivel + ping" }
                ] },
              { "key": "skip_splash_screens", "section": "GAMEPLAY", "type": "toggle", "default": "0",
                "label": { "fr": "Passer les logos d'intro", "en": "Skip intro logos", "es": "Saltar logos de inicio" } },
              { "key": "default_boot_master_volume", "section": "GAMEPLAY", "type": "slider", "min": 0, "max": 10, "step": 1, "default": "5",
                "label": { "fr": "Volume au démarrage", "en": "Startup volume", "es": "Volumen al iniciar" },
                "format": "{0} / 10",
                "zero": { "fr": "muet", "en": "muted", "es": "silencio" } }
            ]
          },
          {
            "title": { "fr": "DIFFICULTÉ", "en": "DIFFICULTY", "es": "DIFICULTAD" },
            "reset": true,
            "items": [
              { "type": "note",
                "label": { "fr": "Bonus ajouté par joueur supplémentaire dans la session.", "en": "Bonus added for each extra player in the session.", "es": "Bonificación por cada jugador adicional en la sesión." } },
              { "key": "enemy_health_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 200, "step": 5, "default": "35",
                "label": { "fr": "PV des ennemis", "en": "Enemy health", "es": "Vida de enemigos" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } },
              { "key": "enemy_damage_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 200, "step": 5, "default": "0",
                "label": { "fr": "Dégâts des ennemis", "en": "Enemy damage", "es": "Daño de enemigos" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } },
              { "key": "enemy_posture_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 200, "step": 5, "default": "15",
                "label": { "fr": "Posture des ennemis", "en": "Enemy posture", "es": "Postura de enemigos" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } },
              { "key": "boss_health_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 300, "step": 5, "default": "100",
                "label": { "fr": "PV des boss", "en": "Boss health", "es": "Vida de jefes" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } },
              { "key": "boss_damage_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 200, "step": 5, "default": "0",
                "label": { "fr": "Dégâts des boss", "en": "Boss damage", "es": "Daño de jefes" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } },
              { "key": "boss_posture_scaling", "section": "SCALING", "type": "slider", "min": 0, "max": 200, "step": 5, "default": "20",
                "label": { "fr": "Posture des boss", "en": "Boss posture", "es": "Postura de jefes" }, "format": { "fr": "+{0} %", "en": "+{0}%", "es": "+{0} %" } }
            ]
          },
          {
            "title": { "fr": "AVANCÉ", "en": "ADVANCED", "es": "AVANZADO" },
            "items": [
              { "key": "save_file_extension", "section": "SAVE", "type": "text", "maxLength": 120, "default": "co2", "sanitize": "alnum", "placeholder": "co2",
                "label": { "fr": "Extension des sauvegardes Seamless", "en": "Seamless save file extension", "es": "Extensión de las partidas Seamless" },
                "hint": { "fr": "Tes sauvegardes vanilla (.sl2) ne sont jamais modifiées", "en": "Your vanilla saves (.sl2) are never modified", "es": "Tus partidas vanilla (.sl2) nunca se modifican" } },
              { "key": "append_steam_id_to_players", "section": "GAMEPLAY", "type": "toggle", "default": "0",
                "label": { "fr": "Afficher le Steam ID des joueurs", "en": "Show players' Steam ID", "es": "Mostrar el Steam ID de los jugadores" },
                "hint": { "fr": "Utile pour repérer et bloquer un tricheur", "en": "Handy to spot and block a cheater", "es": "Útil para detectar y bloquear a un tramposo" } }
            ]
          }
        ]
      }
    },
